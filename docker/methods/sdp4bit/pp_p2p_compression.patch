+# Copyright (c) 2026, Igor Polyakov, ITMO University.
+# Licensed under the Apache License, Version 2.0 (http://www.apache.org/licenses/LICENSE-2.0).
+
+"""Lossy compression of the tensors sent between pipeline stages.
+
+Two flows go over the wire in pipeline parallelism: activations from a stage to the next one
+(forward) and the gradients of those activations back to the previous stage (backward). Each flow
+gets its own codec, chosen with environment variables that are read once, on the first send or
+receive:
+
+    PP_P2P_COMPRESS        codec of the forward flow (activations): none | fp8 | int8 | nvfp4
+    PP_P2P_COMPRESS_GRAD   codec of the backward flow (gradients); defaults to PP_P2P_COMPRESS
+
+All stages must run with the same values. The codecs quantize blocks of consecutive elements of
+the flattened tensor with a local scale, so they need no communication of their own:
+
+    fp8    E4M3 codes, blocks of 128, float32 scale per block      1.03 bytes per element
+    int8   symmetric int8 codes, blocks of 128, float32 scale       1.03 bytes per element
+    nvfp4  E2M1 codes, blocks of 16, E4M3 scale per block and one   0.56 bytes per element
+           float32 scale per tensor (the NVFP4 layout)
+
+Codes and scales are packed into one uint8 buffer whose size depends only on the number of
+elements, so the receiver allocates it from the tensor shape it already knows. The arithmetic is
+float32 and rounds to nearest. A non-finite value decodes to NaN together with its block (fp8,
+int8) or its whole tensor (nvfp4, whose tensor scale it poisons), so that an overflow stays visible
+on the receiving stage.
+"""
+
+import math
+import os
+from typing import Optional, Sequence
+
+import torch
+
+_FP8_MAX = 448.0  # largest finite E4M3 value
+_FP4_MAX = 6.0  # largest E2M1 value
+_E2M1_VALUES = (0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0)
+_E2M1_MIDPOINTS = (0.25, 0.75, 1.25, 1.75, 2.5, 3.5, 5.0)
+
+_tables = {}
+
+
+def _table(values, device):
+    key = (values, device)
+    if key not in _tables:
+        _tables[key] = torch.tensor(values, dtype=torch.float32, device=device)
+    return _tables[key]
+
+
+def _blocks(x: torch.Tensor, block: int):
+    """Flattened float32 copy of x, zero-padded to whole blocks, as (num_blocks, block)."""
+    flat = x.detach().reshape(-1).float()
+    numel = flat.numel()
+    num_blocks = max(1, math.ceil(numel / block))
+    pad = num_blocks * block - numel
+    if pad:
+        flat = torch.nn.functional.pad(flat, (0, pad))
+    return flat.view(num_blocks, block), num_blocks
+
+
+def _scale(amax: torch.Tensor, qmax: float) -> torch.Tensor:
+    """amax / qmax; 1 for all-zero blocks; NaN for blocks with a non-finite value."""
+    scale = torch.where(amax > 0, amax / qmax, torch.ones_like(amax))
+    return torch.where(torch.isfinite(amax), scale, torch.full_like(amax, float('nan')))
+
+
+def _numel(shape: Sequence[int]) -> int:
+    return int(math.prod(shape))
+
+
+class _BlockCodec:
+    """8-bit codes with a float32 scale per block. Layout: [scales: float32 x B][codes: 1 byte x N]."""
+
+    name = None
+    block = 128
+
+    def packed_nbytes(self, numel: int) -> int:
+        num_blocks = max(1, math.ceil(numel / self.block))
+        return num_blocks * 4 + num_blocks * self.block
+
+    def empty_wire(self, shape: Sequence[int], device) -> torch.Tensor:
+        return torch.empty(self.packed_nbytes(_numel(shape)), dtype=torch.uint8, device=device)
+
+    def encode(self, x: torch.Tensor) -> torch.Tensor:
+        blocks, num_blocks = _blocks(x, self.block)
+        scale = _scale(blocks.abs().amax(dim=1, keepdim=True), self.qmax)
+        wire = torch.empty(self.packed_nbytes(x.numel()), dtype=torch.uint8, device=x.device)
+        wire[: num_blocks * 4].view(torch.float32).copy_(scale.view(-1))
+        wire[num_blocks * 4 :].view(self.code_dtype).copy_(self._quantize(blocks / scale).view(-1))
+        return wire
+
+    def decode(self, wire: torch.Tensor, shape: Sequence[int], dtype: torch.dtype) -> torch.Tensor:
+        numel = _numel(shape)
+        num_blocks = max(1, math.ceil(numel / self.block))
+        scale = wire[: num_blocks * 4].view(torch.float32).view(num_blocks, 1)
+        codes = wire[num_blocks * 4 : num_blocks * 4 + num_blocks * self.block]
+        values = codes.view(self.code_dtype).view(num_blocks, self.block).float() * scale
+        return values.view(-1)[:numel].view(shape).to(dtype)
+
+
+class _Fp8Codec(_BlockCodec):
+    name = 'fp8'
+    qmax = _FP8_MAX
+    code_dtype = torch.float8_e4m3fn
+
+    def _quantize(self, scaled: torch.Tensor) -> torch.Tensor:
+        # The cast to E4M3 rounds to nearest; clamping keeps rounding error near the maximum
+        # from turning into NaN, which is the only special value of E4M3
+        return scaled.clamp(-_FP8_MAX, _FP8_MAX).to(torch.float8_e4m3fn)
+
+
+class _Int8Codec(_BlockCodec):
+    name = 'int8'
+    qmax = 127.0
+    code_dtype = torch.int8
+
+    def _quantize(self, scaled: torch.Tensor) -> torch.Tensor:
+        # NaN has no int8 code; the NaN scale of such a block still decodes it to NaN
+        return torch.nan_to_num(scaled, nan=0.0).round().clamp(-127, 127).to(torch.int8)
+
+
+class _Nvfp4Codec:
+    """E2M1 codes in blocks of 16 with an E4M3 scale each and a float32 scale per tensor.
+
+    Layout: [tensor scale: float32][block scales: E4M3 x B][codes: two per byte, low nibble first].
+    A code is the index of the E2M1 magnitude (3 bits) and the sign (bit 3).
+    """
+
+    name = 'nvfp4'
+    block = 16
+
+    def packed_nbytes(self, numel: int) -> int:
+        num_blocks = max(1, math.ceil(numel / self.block))
+        return 4 + num_blocks + num_blocks * self.block // 2
+
+    def empty_wire(self, shape: Sequence[int], device) -> torch.Tensor:
+        return torch.empty(self.packed_nbytes(_numel(shape)), dtype=torch.uint8, device=device)
+
+    def encode(self, x: torch.Tensor) -> torch.Tensor:
+        blocks, num_blocks = _blocks(x, self.block)
+        block_amax = blocks.abs().amax(dim=1, keepdim=True)
+        # The tensor scale maps the largest block scale onto the largest E4M3 value
+        tensor_scale = _scale(block_amax.amax().view(1), _FP4_MAX * _FP8_MAX)
+        block_scale = (block_amax / _FP4_MAX / tensor_scale).clamp(max=_FP8_MAX)
+        block_scale = torch.nan_to_num(block_scale, nan=0.0).to(torch.float8_e4m3fn)
+        effective = block_scale.float() * tensor_scale
+        scaled = torch.where(effective > 0, blocks / effective, torch.zeros_like(blocks))
+        index = torch.bucketize(
+            scaled.abs().clamp(max=_FP4_MAX), _table(_E2M1_MIDPOINTS, blocks.device)
+        )
+        codes = (index | (scaled < 0).long() << 3).to(torch.uint8).view(-1)
+        wire = torch.empty(self.packed_nbytes(x.numel()), dtype=torch.uint8, device=x.device)
+        wire[:4].view(torch.float32).copy_(tensor_scale)
+        wire[4 : 4 + num_blocks].view(torch.float8_e4m3fn).copy_(block_scale.view(-1))
+        wire[4 + num_blocks :].copy_(codes[0::2] | (codes[1::2] << 4))
+        return wire
+
+    def decode(self, wire: torch.Tensor, shape: Sequence[int], dtype: torch.dtype) -> torch.Tensor:
+        numel = _numel(shape)
+        num_blocks = max(1, math.ceil(numel / self.block))
+        tensor_scale = wire[:4].view(torch.float32)
+        block_scale = wire[4 : 4 + num_blocks].view(torch.float8_e4m3fn).float().view(num_blocks, 1)
+        packed = wire[4 + num_blocks : 4 + num_blocks + num_blocks * self.block // 2]
+        codes = torch.stack((packed & 0xF, packed >> 4), dim=1).view(num_blocks, self.block)
+        magnitude = _table(_E2M1_VALUES, wire.device)[(codes & 7).long()]
+        sign = 1.0 - 2.0 * (codes >> 3).float()
+        values = magnitude * sign * (block_scale * tensor_scale)
+        return values.view(-1)[:numel].view(shape).to(dtype)
+
+
+CODECS = {codec.name: codec for codec in (_Fp8Codec(), _Int8Codec(), _Nvfp4Codec())}
+
+_config = None
+
+
+def _read_config():
+    forward = os.environ.get('PP_P2P_COMPRESS', 'none').strip().lower() or 'none'
+    backward = os.environ.get('PP_P2P_COMPRESS_GRAD', forward).strip().lower() or forward
+    for variable, value in (('PP_P2P_COMPRESS', forward), ('PP_P2P_COMPRESS_GRAD', backward)):
+        if value != 'none' and value not in CODECS:
+            raise ValueError(
+                f'{variable}={value}: expected none or one of {", ".join(sorted(CODECS))}'
+            )
+    codecs = (CODECS.get(forward), CODECS.get(backward))
+    if forward != 'none' or backward != 'none':
+        rank = torch.distributed.get_rank() if torch.distributed.is_initialized() else 0
+        print(
+            f'[rank {rank}] pipeline p2p compression: activations={forward}, gradients={backward}',
+            flush=True,
+        )
+    return codecs
+
+
+def codecs():
+    """(codec of the forward flow, codec of the backward flow); None means uncompressed."""
+    global _config
+    if _config is None:
+        _config = _read_config()
+    return _config
+
+
+def reset():
+    """Read the environment variables again on the next call (for tests)."""
+    global _config
+    _config = None
+
+
+def encode(codec, tensor: Optional[torch.Tensor]) -> Optional[torch.Tensor]:
+    if codec is None or tensor is None:
+        return tensor
+    return codec.encode(tensor)
