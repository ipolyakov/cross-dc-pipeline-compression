@@ -0,0 +1,185 @@
+# Copyright (c) 2026, Igor Polyakov, ITMO University.
+# Licensed under the Apache License, Version 2.0 (http://www.apache.org/licenses/LICENSE-2.0).
+
+"""Checks of the pipeline p2p compression (megatron/core/pipeline_parallel/p2p_compression.py).
+
+Run from the repository root on a host with two GPUs:
+
+    torchrun --nproc_per_node=2 tools/test_p2p_compression.py
+
+1. Codec round trips on rank 0: packed size, error, zeros, NaN, odd sizes, bf16 and fp32.
+2. The two ranks form a pipeline of two stages (PP=2) and exchange activations and gradients
+   through the real send/recv functions of p2p_communication.py, for every codec. The receiver
+   compares what arrives with the sent tensor, which it regenerates from the same seed.
+
+Prints one line per check and "ALL CHECKS PASSED" at the end; any failure raises.
+"""
+
+import datetime
+import os
+import sys
+
+import torch
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+
+def progress(message):
+    """Where each rank is: the last line of a rank that hangs shows the step it waits in."""
+    print(f'[rank {os.environ.get("RANK", "?")}] {message}', flush=True)
+
+
+progress('importing megatron')
+from megatron.core import ModelParallelConfig, parallel_state  # noqa: E402
+from megatron.core.pipeline_parallel import p2p_communication, p2p_compression  # noqa: E402
+
+progress('imports done')
+
+SHAPE = (2048, 1, 1280)  # sequence, micro-batch, hidden of the 539M model
+# Bounds on the relative RMS error for Gaussian data; measured values are well below
+RMS_BOUND = {'none': 0.0, 'fp8': 0.04, 'int8': 0.01, 'nvfp4': 0.15}
+BYTES_PER_ELEMENT = {'fp8': 1.03125, 'int8': 1.03125, 'nvfp4': 0.5625}
+
+
+def rel_rms(a, b):
+    a, b = a.float(), b.float()
+    return ((a - b).pow(2).mean().sqrt() / b.pow(2).mean().sqrt()).item()
+
+
+def check(condition, message):
+    if not condition:
+        raise AssertionError(message)
+    print('  ok', message, flush=True)
+
+
+def codec_checks(device):
+    print('codec round trips on', device, flush=True)
+    gen = torch.Generator(device='cpu').manual_seed(0)
+    for name, codec in sorted(p2p_compression.CODECS.items()):
+        for shape in (SHAPE, (1000, 3, 7), (5,)):
+            for dtype in (torch.bfloat16, torch.float32):
+                x = torch.randn(shape, generator=gen).to(device=device, dtype=dtype)
+                wire = codec.encode(x)
+                check(
+                    wire.dtype == torch.uint8 and wire.numel() == codec.packed_nbytes(x.numel()),
+                    f'{name} {shape} {dtype}: packed size {wire.numel()}',
+                )
+                y = codec.decode(wire, shape, dtype)
+                check(y.shape == x.shape and y.dtype == dtype, f'{name} {shape}: shape, dtype')
+                err = rel_rms(y, x)
+                if x.numel() >= 1000:  # the bounds are statistical
+                    check(err < RMS_BOUND[name], f'{name} {shape} {dtype}: rel RMS error {err:.4f}')
+                else:
+                    check(err < 0.5, f'{name} {shape} {dtype}: rel RMS error {err:.4f}')
+        ratio = codec.packed_nbytes(1 << 20) / (1 << 20)
+        check(
+            abs(ratio - BYTES_PER_ELEMENT[name]) < 1e-3, f'{name}: {ratio:.4f} bytes per element'
+        )
+        # Outliers stay local to their block: a large value spoils only its neighbours
+        x = torch.randn(SHAPE, generator=gen).to(device)
+        x.view(-1)[12345] = 1e4
+        y = codec.decode(codec.encode(x), SHAPE, torch.float32)
+        mask = torch.ones(x.numel(), dtype=torch.bool, device=device)
+        mask[12345 - 200 : 12345 + 200] = False
+        far = rel_rms(y.view(-1)[mask], x.view(-1)[mask])
+        if name == 'nvfp4':
+            # The tensor scale follows the outlier, so small blocks lose E4M3 scale resolution
+            check(far < 0.5, f'{name}: error away from an outlier {far:.4f}')
+        else:
+            check(far < RMS_BOUND[name], f'{name}: error away from an outlier {far:.4f}')
+        zeros = torch.zeros(SHAPE, device=device, dtype=torch.bfloat16)
+        check(
+            torch.equal(codec.decode(codec.encode(zeros), SHAPE, torch.bfloat16), zeros),
+            f'{name}: zeros decode to zeros',
+        )
+        x = torch.randn(SHAPE, generator=gen).to(device)
+        x.view(-1)[7] = float('nan')
+        y = codec.decode(codec.encode(x), SHAPE, torch.float32)
+        check(torch.isnan(y.view(-1)[7]).item(), f'{name}: NaN stays NaN')
+        if name != 'nvfp4':
+            block = codec.block
+            check(
+                torch.isfinite(y.view(-1)[block:]).all().item(),
+                f'{name}: NaN spoils only its block',
+            )
+    # Values on the E4M3 grid survive fp8 exactly when the block maximum is 448
+    grid = torch.tensor([448.0, 1.0, -2.5, 0.0, 0.015625, -96.0], device=device)
+    fp8 = p2p_compression.CODECS['fp8']
+    check(
+        torch.equal(fp8.decode(fp8.encode(grid), grid.shape, torch.float32), grid),
+        'fp8: E4M3 grid values are exact',
+    )
+
+
+def pipeline_checks(rank):
+    config = ModelParallelConfig(
+        pipeline_model_parallel_size=2, pipeline_dtype=torch.bfloat16, bf16=True
+    )
+    for name in ['none'] + sorted(p2p_compression.CODECS):
+        for grad_name in sorted({name, 'none'}):
+            os.environ['PP_P2P_COMPRESS'] = name
+            os.environ['PP_P2P_COMPRESS_GRAD'] = grad_name
+            p2p_compression.reset()
+            label = f'activations={name} gradients={grad_name}'
+
+            def tensor(seed):
+                gen = torch.Generator(device='cpu').manual_seed(seed)
+                return torch.randn(SHAPE, generator=gen).to(device='cuda', dtype=torch.bfloat16)
+
+            # Separate calls: send_forward / recv_forward, then send_backward / recv_backward
+            if rank == 0:
+                p2p_communication.send_forward(tensor(1), config)
+                grad = p2p_communication.recv_backward(SHAPE, config)
+                check(grad.requires_grad and grad.dtype == torch.bfloat16, f'{label}: grad leaf')
+                err = rel_rms(grad, tensor(2))
+                check(err <= RMS_BOUND[grad_name], f'{label}: gradient error {err:.4f}')
+            else:
+                act = p2p_communication.recv_forward(SHAPE, config)
+                check(act.requires_grad and act.dtype == torch.bfloat16, f'{label}: activation leaf')
+                err = rel_rms(act, tensor(1))
+                check(err <= RMS_BOUND[name], f'{label}: activation error {err:.4f}')
+                p2p_communication.send_backward(tensor(2), config)
+            # Combined calls of the 1F1B steady state: both flows in one batch_isend_irecv
+            if rank == 0:
+                p2p_communication.send_forward(tensor(3), config)
+                grad = p2p_communication.send_forward_recv_backward(tensor(5), SHAPE, config)
+                err = rel_rms(grad, tensor(4))
+                check(err <= RMS_BOUND[grad_name], f'{label}: combined, gradient error {err:.4f}')
+                grad = p2p_communication.recv_backward(SHAPE, config)
+                err = rel_rms(grad, tensor(6))
+                check(err <= RMS_BOUND[grad_name], f'{label}: last gradient error {err:.4f}')
+            else:
+                act = p2p_communication.recv_forward(SHAPE, config)
+                err = rel_rms(act, tensor(3))
+                check(err <= RMS_BOUND[name], f'{label}: activation error {err:.4f}')
+                act = p2p_communication.send_backward_recv_forward(tensor(4), SHAPE, config)
+                err = rel_rms(act, tensor(5))
+                check(err <= RMS_BOUND[name], f'{label}: combined, activation error {err:.4f}')
+                p2p_communication.send_backward(tensor(6), config)
+            torch.distributed.barrier()
+
+
+def main():
+    rank = int(os.environ['RANK'])
+    torch.cuda.set_device(int(os.environ.get('LOCAL_RANK', rank)))
+    progress(f'GPU {torch.cuda.current_device()}: {torch.cuda.get_device_name()}')
+    if rank == 0:
+        codec_checks('cpu')
+        codec_checks('cuda')
+    master = f'{os.environ.get("MASTER_ADDR")}:{os.environ.get("MASTER_PORT")}'
+    progress(f'init_process_group(nccl) with {master}')
+    # A rank that cannot reach the other one fails after 3 minutes instead of waiting forever
+    torch.distributed.init_process_group('nccl', timeout=datetime.timedelta(minutes=3))
+    parallel_state.initialize_model_parallel(
+        tensor_model_parallel_size=1, pipeline_model_parallel_size=2
+    )
+    progress('process groups ready; the first send/recv initializes NCCL between the ranks')
+    pipeline_checks(rank)
+    torch.distributed.barrier()
+    if rank == 0:
+        print('ALL CHECKS PASSED', flush=True)
+    torch.distributed.destroy_process_group()
+
+
+if __name__ == '__main__':
+    main()
