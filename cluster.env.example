# Copy to cluster.env at the repository root and fill in. The launchers in
# docker/methods/cross-dc-pipeline-compression/ source ../../../cluster.env. Do not commit the filled file.

# Container registry that holds the training image (SDP4Bit + this patch).
ECR_REGISTRY=
ECR_REGION=
IMAGE_REPO=
DEV_REGISTRY=

# Dataset and experiment buckets. Replicas is "REGION=PREFIX,REGION=PREFIX".
S3_DATASETS=
S3_DATASETS_REPLICAS=
S3_EXPERIMENTS=

# Dev cluster: two hosts, one GPU each for the 539M runs.
DEV_NODES=2
DEV_GPUS_PER_NODE=1
DEV_SDP4BIT_EXPERIMENTS=
DEV_SDP4BIT_DATASET=

# AWS hosts for the 6.7B runs. Credentials come from the local aws CLI, not from here.
SSH_USER=ubuntu
N_NODES=2
GPUS_PER_NODE=8
